# ---------------------------------------------------------------------------
# LabelCheck environment variables
# Copy to `.env` and fill in real values.  Never commit the filled-in `.env`.
# On Lovable Cloud these are injected automatically.
# ---------------------------------------------------------------------------

# --- Client-visible (bundled into the browser build, safe to expose) --------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-anon-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# --- Server-only (SSR + server functions; NEVER prefix these with VITE_) ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-anon-key>
SUPABASE_PROJECT_ID=<project-ref>

# Used only by privileged server code. Bypasses row-level security.
# Leave unset unless you actually need admin operations.
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- AI / OCR ---------------------------------------------------------------
# Key for the AI gateway used by the OCR server function.
LOVABLE_API_KEY=<api-key>

# --- Optional ---------------------------------------------------------------
# Shared secret for scheduled/cron callbacks hitting /api/public/*
# LOVABLE_CRON_SECRET=<random-string>
