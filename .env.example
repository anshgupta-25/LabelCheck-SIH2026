# ---------------------------------------------------------------------------
# LabelCheck environment variables
# Copy to `.env` and fill in real values.  Never commit the filled-in `.env`.
# ---------------------------------------------------------------------------

# --- Supabase: client-visible (bundled into the browser build, safe to expose)
# Project settings → API in the Supabase dashboard.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# --- Supabase: server-only (SSR + server functions; NEVER prefix with VITE_)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_PROJECT_ID=<project-ref>

# --- OCR (server-only) -------------------------------------------------------
# Any OpenAI-compatible vision model works. Set the key, then (optionally) the
# endpoint and model. Defaults are Google Gemini.
OCR_API_KEY=<api-key>

# Google Gemini (default) — key from https://aistudio.google.com/apikey
# OCR_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# OCR_MODEL=gemini-2.5-flash

# OpenAI — key from https://platform.openai.com/api-keys
# OCR_API_URL=https://api.openai.com/v1/chat/completions
# OCR_MODEL=gpt-4.1-mini
